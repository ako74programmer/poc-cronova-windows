#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

WORKSPACE=""
PROJECT="demo"
PACKAGE="com.example.demo"
MAX_ITER=3
PROVIDER_ID=""
MODEL=""
PYTHON="${PYTHON:-/c/Users/Andrzej/AppData/Local/Programs/Python/Python313/python}"
DB_FILE="${CRONOVA_DB:-$REPO_ROOT/data/cronova.db}"

# Resolve AI provider configuration from the cronova SQLite database.
# Falls back to CRONOVA_AI_* env vars, then to empty (caller must supply -r/-m).
resolve_provider() {
  if [[ -n "${CRONOVA_AI_BASE_URL:-}" && -n "${CRONOVA_AI_MODEL:-}" ]]; then
    echo "${CRONOVA_AI_BASE_URL}|${CRONOVA_AI_MODEL}|${CRONOVA_AI_TOKEN:-}"
    return 0
  fi
  if [[ -f "$DB_FILE" ]]; then
    local out
    out=$("$PYTHON" - "$DB_FILE" "$PROVIDER_ID" <<'PY'
import sqlite3, sys
db = sys.argv[1]
provider_id = sys.argv[2] if len(sys.argv) > 2 else None
try:
    con = sqlite3.connect(db)
    cur = con.cursor()
    if provider_id:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE id=?", (provider_id,)).fetchone()
    else:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE is_default=1 LIMIT 1").fetchone()
    if row:
        print("|".join(str(c) for c in row))
except Exception:
    pass
PY
    )
    if [[ -n "$out" ]]; then
      echo "$out"
      return 0
    fi
  fi
  return 1
}

usage() {
  cat <<EOF
Usage: ai-review-fix-loop [-w WORKSPACE] [-p PROJECT] [-k PACKAGE] [-i ITERATIONS] [-r PROVIDER_ID] [-m MODEL] [-y PYTHON] [-h]

Options:
  -w WORKSPACE    Target workspace directory. Default: workspaces/springboot-demo
  -p PROJECT      Project subdirectory inside workspace. Default: demo
  -k PACKAGE      Java package. Default: com.example.demo
  -i ITERATIONS   Maximum review/fix iterations. Default: 3
  -r PROVIDER_ID  AI provider id from cronova config. Default: provider marked as default
  -m MODEL        AI model to use. Default: model from default provider (or CRONOVA_AI_MODEL env)
  -y PYTHON       Path to Python interpreter. Default: /c/Users/Andrzej/AppData/Local/Programs/Python/Python313/python
  -h              Show this help message.

Example:
  ai-review-fix-loop
  ai-review-fix-loop -w workspaces/my-app -p app -k com.example.app -i 5
  ai-review-fix-loop -m "Kimi K2.7 Code"
EOF
}

while getopts ":w:p:k:i:r:m:y:h" opt; do
  case $opt in
    w) WORKSPACE="$OPTARG" ;;
    p) PROJECT="$OPTARG" ;;
    k) PACKAGE="$OPTARG" ;;
    i) MAX_ITER="$OPTARG" ;;
    r) PROVIDER_ID="$OPTARG" ;;
    m) MODEL="$OPTARG" ;;
    y) PYTHON="$OPTARG" ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage >&2; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage >&2; exit 1 ;;
  esac
done

AI_BASE_URL="${CRONOVA_AI_BASE_URL:-}"
AI_TOKEN="${CRONOVA_AI_TOKEN:-}"
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  PROVIDER_INFO=$(resolve_provider) || true
  if [[ -n "$PROVIDER_INFO" ]]; then
    AI_BASE_URL="${AI_BASE_URL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f1)}"
    MODEL="${MODEL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f2)}"
    AI_TOKEN="${AI_TOKEN:-$(echo "$PROVIDER_INFO" | cut -d'|' -f3)}"
  fi
fi
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  echo "Error: could not determine AI provider. Configure a default AI provider in cronova, set CRONOVA_AI_BASE_URL and CRONOVA_AI_MODEL, or pass -r PROVIDER_ID and -m MODEL." >&2
  exit 1
fi

if [[ -z "$WORKSPACE" ]]; then
  WORKSPACE="$REPO_ROOT/workspaces/springboot-demo"
fi

PROJECT_DIR="$WORKSPACE/$PROJECT"
M2_DIR="$REPO_ROOT/.m2/repository"
TMP_DIR="$REPO_ROOT/.tmp"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Error: project directory not found: $PROJECT_DIR" >&2
  exit 1
fi

mkdir -p "$M2_DIR"
mkdir -p "$TMP_DIR"
cd "$PROJECT_DIR"

export JAVA_HOME=/c/Program\ Files/Java/jdk-25
export PATH="/c/apache-maven-3.9.14/bin:/mingw64/bin:/usr/bin:/bin:/c/Windows/system32:/c/Windows:$PATH"

ITER=1
while [ "$ITER" -le "$MAX_ITER" ]; do
  echo "=== compile iteration $ITER / $MAX_ITER ==="
  if mvn -B -Dmaven.repo.local="$M2_DIR" -DskipTests compile > "$TMP_DIR/compile.log" 2>&1; then
    echo "Compile succeeded on iteration $ITER"
    exit 0
  fi

  echo "Compile failed. Sending report to AI reviewer..."
  tail -n 80 "$TMP_DIR/compile.log"

  if [ "$ITER" -eq "$MAX_ITER" ]; then
    echo "Max iterations reached. Giving up."
    cat "$TMP_DIR/compile.log"
    exit 1
  fi

  SRC_FILES=$(find src/main/java -name "*.java" -exec echo "--- {} ---" \; -exec cat {} \;)
  POM=$(cat pom.xml)
  LOG=$(tail -n 80 "$TMP_DIR/compile.log")

  cat > "$TMP_DIR/ai_review_prompt.txt" <<PROMPT_EOF
You are a Java build-error reviewer. The Spring Boot project below failed to compile.
Fix the code (and pom.xml if needed) so it compiles. Keep the Item CRUD functionality.
IMPORTANT:
- do NOT add <version> tags to dependencies that are managed by the Spring Boot parent POM. Use only <groupId> and <artifactId> for Spring Boot starters.
- Use jakarta.validation.constraints.NotBlank and jakarta.validation.Valid (NOT javax.validation).
Return ONLY a JSON object with keys: pom_xml, and for each Java file you change, key = relative path like "src/main/java/com/example/demo/api/ItemController.java".
Escape newlines in strings as \\n and quotes as \\".

pom.xml:
$POM

Compile error:
$LOG

Source files:
$SRC_FILES
PROMPT_EOF

  "$PYTHON" "$REPO_ROOT/internal/scripts/ai/review_fix_v2.py" "$PROJECT_DIR" "$(echo "$PACKAGE" | tr '.' '/')" "$TMP_DIR/ai_review_prompt.txt" "$TMP_DIR/ai_review_request.json" "$TMP_DIR/ai_review.json" "$MODEL" "$AI_BASE_URL" "$AI_TOKEN"

  ITER=$((ITER + 1))
done
