#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$SCRIPT_DIR/common_toolchain.sh"

WORKSPACE=""
PROJECT="demo"
PACKAGE="com.example.demo"
PROVIDER_ID=""
MODEL=""
PYTHON="${PYTHON:-${CRONOVA_PYTHON:-}}"
DB_FILE="${CRONOVA_DB:-$REPO_ROOT/data/cronova.db}"

# Resolve AI provider configuration from the cronova SQLite database.
# Falls back to CRONOVA_AI_* env vars, then to empty (caller must supply -r/-m).
resolve_provider() {
  if [[ -n "${CRONOVA_AI_BASE_URL:-}" && -n "${CRONOVA_AI_MODEL:-}" ]]; then
    echo "${CRONOVA_AI_BASE_URL}|${CRONOVA_AI_MODEL}|${CRONOVA_AI_TOKEN:-}"
    return 0
  fi
  if [[ -f "$DB_FILE" ]]; then
    local out
    out=$("$PYTHON" - "$DB_FILE" "$PROVIDER_ID" <<'PY'
import sqlite3, sys
db = sys.argv[1]
provider_id = sys.argv[2] if len(sys.argv) > 2 else None
try:
    con = sqlite3.connect(db)
    cur = con.cursor()
    if provider_id:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE id=?", (provider_id,)).fetchone()
    else:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE is_default=1 LIMIT 1").fetchone()
    if row:
        print("|".join(str(c) for c in row))
except Exception:
    pass
PY
    )
    if [[ -n "$out" ]]; then
      echo "$out"
      return 0
    fi
  fi
  return 1
}

usage() {
  cat <<EOF
Usage: ai-generate-crud [-w WORKSPACE] [-p PROJECT] [-k PACKAGE] [-r PROVIDER_ID] [-m MODEL] [-y PYTHON] [-h]

Options:
  -w WORKSPACE   Target workspace directory. Default: workspaces/springboot-demo
  -p PROJECT     Project subdirectory inside workspace. Default: demo
  -k PACKAGE     Java package. Default: com.example.demo
  -r PROVIDER_ID AI provider id from cronova config. Default: provider marked as default
  -m MODEL       AI model to use. Default: model from default provider (or CRONOVA_AI_MODEL env)
  -y PYTHON      Path or command for Python. Default: autodetected or CRONOVA_PYTHON
  -h             Show this help message.

Example:
  ai-generate-crud
  ai-generate-crud -w workspaces/my-app -p app -k com.example.app
  ai-generate-crud -m "Kimi K2.7 Code"
EOF
}

while getopts ":w:p:k:r:m:y:h" opt; do
  case $opt in
    w) WORKSPACE="$OPTARG" ;;
    p) PROJECT="$OPTARG" ;;
    k) PACKAGE="$OPTARG" ;;
    r) PROVIDER_ID="$OPTARG" ;;
    m) MODEL="$OPTARG" ;;
    y) PYTHON="$OPTARG" ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage >&2; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage >&2; exit 1 ;;
  esac
done
PYTHON="$(find_python "$PYTHON")"

AI_BASE_URL="${CRONOVA_AI_BASE_URL:-}"
AI_TOKEN="${CRONOVA_AI_TOKEN:-}"
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  PROVIDER_INFO=$(resolve_provider) || true
  if [[ -n "$PROVIDER_INFO" ]]; then
    AI_BASE_URL="${AI_BASE_URL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f1)}"
    MODEL="${MODEL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f2)}"
    AI_TOKEN="${AI_TOKEN:-$(echo "$PROVIDER_INFO" | cut -d'|' -f3)}"
  fi
fi
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  echo "Error: could not determine AI provider. Configure a default AI provider in cronova, set CRONOVA_AI_BASE_URL and CRONOVA_AI_MODEL, or pass -r PROVIDER_ID and -m MODEL." >&2
  exit 1
fi

if [[ -z "$WORKSPACE" ]]; then
  WORKSPACE="$REPO_ROOT/workspaces/springboot-demo"
fi

PROJECT_DIR="$WORKSPACE/$PROJECT"
TMP_DIR="$REPO_ROOT/.tmp"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Error: project directory not found: $PROJECT_DIR" >&2
  exit 1
fi

mkdir -p "$TMP_DIR"
mkdir -p "$PROJECT_DIR/src/main/java/$(echo "$PACKAGE" | tr '.' '/')/api"
mkdir -p "$PROJECT_DIR/src/main/java/$(echo "$PACKAGE" | tr '.' '/')/model"

POM=$(cat "$PROJECT_DIR/pom.xml")
APP=$(cat "$PROJECT_DIR/src/main/java/$(echo "$PACKAGE" | tr '.' '/')/DemoApplication.java")

PROMPT_FILE="$TMP_DIR/ai_prompt.txt"
REQ_FILE="$TMP_DIR/ai_request.json"
RESP_FILE="$TMP_DIR/ai_response.json"

cat > "$PROMPT_FILE" <<PROMPT_EOF
You are a Java/Spring Boot code generator.
Given the pom.xml and DemoApplication.java below, do two things:
1. Ensure pom.xml contains dependencies for Spring Boot web and validation (e.g. spring-boot-starter-webmvc and spring-boot-starter-validation). Do NOT add <version> tags for dependencies managed by the Spring Boot parent POM. Keep everything else intact.
2. Add a simple Item CRUD: create Item.java in model package and ItemController.java in api package.
   Item fields: Long id, String name. Controller: REST endpoints GET /items, POST /items, GET /items/{id}, DELETE /items/{id}.
   Store items in a java.util.Map<Long, Item> in the controller.
   Use jakarta.validation.constraints.NotBlank and jakarta.validation.Valid (NOT javax.validation).
Return ONLY a JSON object with keys: pom_xml, Item_java, ItemController_java.
Escape newlines in strings as \\n and quotes as \\".

pom.xml:
$POM

DemoApplication.java:
$APP
PROMPT_EOF

echo "Calling AI provider (model: $MODEL, url: $AI_BASE_URL)..."
"$PYTHON" "$REPO_ROOT/internal/scripts/ai/add_crud.py" "$PROJECT_DIR" "$(echo "$PACKAGE" | tr '.' '/')" "$PROMPT_FILE" "$REQ_FILE" "$RESP_FILE" "$MODEL" "$AI_BASE_URL" "$AI_TOKEN"

echo "AI added CRUD to $PROJECT_DIR"
