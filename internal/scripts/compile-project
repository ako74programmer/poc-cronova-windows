#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$SCRIPT_DIR/common_toolchain.sh"

WORKSPACE=""
PROJECT="demo"
MAVEN_GOAL="compile"
SKIP_TESTS=true

usage() {
  cat <<EOF
Usage: compile-project [-w WORKSPACE] [-p PROJECT] [-g GOAL] [-t] [-h]

Options:
  -w WORKSPACE  Target workspace directory. Default: workspaces/springboot-demo
  -p PROJECT    Project subdirectory inside workspace. Default: demo
  -g GOAL       Maven goal. Default: compile
  -t            Run tests (by default tests are skipped).
  -h            Show this help message.

Example:
  compile-project
  compile-project -w workspaces/my-app -p app -g test
EOF
}

while getopts ":w:p:g:th" opt; do
  case $opt in
    w) WORKSPACE="$OPTARG" ;;
    p) PROJECT="$OPTARG" ;;
    g) MAVEN_GOAL="$OPTARG" ;;
    t) SKIP_TESTS=false ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage >&2; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -z "$WORKSPACE" ]]; then
  WORKSPACE="$REPO_ROOT/workspaces/springboot-demo"
fi

PROJECT_DIR="$WORKSPACE/$PROJECT"
M2_DIR="$REPO_ROOT/.m2/repository"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Error: project directory not found: $PROJECT_DIR" >&2
  exit 1
fi

mkdir -p "$M2_DIR"
cd "$PROJECT_DIR"

setup_java_maven

MVN_ARGS=(-B -Dmaven.repo.local="$M2_DIR")
if [[ "$SKIP_TESTS" == true ]]; then
  MVN_ARGS+=(-DskipTests)
fi
MVN_ARGS+=("$MAVEN_GOAL")

echo "Running: mvn ${MVN_ARGS[*]} in $PROJECT_DIR"
mvn "${MVN_ARGS[@]}"

echo "Project compiled successfully: $PROJECT_DIR"
