#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

WORKSPACE=""
PROJECT="demo"
PACKAGE="com.example"
PROMPT_FILE=""
PROVIDER_ID=""
MODEL=""
PYTHON="${PYTHON:-/c/Users/Andrzej/AppData/Local/Programs/Python/Python313/python}"
DB_FILE="${CRONOVA_DB:-$REPO_ROOT/data/cronova.db}"

# Resolve AI provider configuration from the cronova SQLite database.
# Falls back to CRONOVA_AI_* env vars, then to empty (caller must supply -r/-m).
resolve_provider() {
  if [[ -n "${CRONOVA_AI_BASE_URL:-}" && -n "${CRONOVA_AI_MODEL:-}" ]]; then
    echo "${CRONOVA_AI_BASE_URL}|${CRONOVA_AI_MODEL}|${CRONOVA_AI_TOKEN:-}"
    return 0
  fi
  if [[ -f "$DB_FILE" ]]; then
    local out
    out=$("$PYTHON" - "$DB_FILE" "$PROVIDER_ID" <<'PY'
import sqlite3, sys
db = sys.argv[1]
provider_id = sys.argv[2] if len(sys.argv) > 2 else None
try:
    con = sqlite3.connect(db)
    cur = con.cursor()
    if provider_id:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE id=?", (provider_id,)).fetchone()
    else:
        row = cur.execute("SELECT base_url, model, token FROM ai_providers WHERE is_default=1 LIMIT 1").fetchone()
    if row:
        print("|".join(str(c) for c in row))
except Exception:
    pass
PY
    )
    if [[ -n "$out" ]]; then
      echo "$out"
      return 0
    fi
  fi
  return 1
}

usage() {
  cat <<EOF
Usage: ai-generate-feature -f PROMPT_FILE [-w WORKSPACE] [-p PROJECT] [-k PACKAGE] [-r PROVIDER_ID] [-m MODEL] [-y PYTHON] [-h]

Generate a business feature in a Java/Maven project using AI.
The PROMPT_FILE should describe what to implement. The AI returns a JSON object
where keys are relative file paths and values are file contents.

Options:
  -f PROMPT_FILE  Path to a file containing the feature prompt (required).
  -w WORKSPACE    Target workspace directory. Default: workspaces/maven-demo
  -p PROJECT      Project subdirectory inside workspace. Default: demo
  -k PACKAGE      Java package. Default: com.example
  -r PROVIDER_ID  AI provider id from cronova config. Default: provider marked as default
  -m MODEL        AI model to use. Default: model from default provider (or CRONOVA_AI_MODEL env)
  -y PYTHON       Path to Python interpreter. Default: /c/Users/Andrzej/AppData/Local/Programs/Python/Python313/python
  -h              Show this help message.

Example:
  ai-generate-feature -f prompts/luhn.txt -w workspaces/sdlc_maven_luhn -p app -k com.example.luhn
  ai-generate-feature -f prompts/luhn.txt -m "Kimi K2.7 Code"
EOF
}

while getopts ":f:w:p:k:r:m:y:h" opt; do
  case $opt in
    f) PROMPT_FILE="$OPTARG" ;;
    w) WORKSPACE="$OPTARG" ;;
    p) PROJECT="$OPTARG" ;;
    k) PACKAGE="$OPTARG" ;;
    r) PROVIDER_ID="$OPTARG" ;;
    m) MODEL="$OPTARG" ;;
    y) PYTHON="$OPTARG" ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage >&2; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage >&2; exit 1 ;;
  esac
done

AI_BASE_URL="${CRONOVA_AI_BASE_URL:-}"
AI_TOKEN="${CRONOVA_AI_TOKEN:-}"
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  PROVIDER_INFO=$(resolve_provider) || true
  if [[ -n "$PROVIDER_INFO" ]]; then
    AI_BASE_URL="${AI_BASE_URL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f1)}"
    MODEL="${MODEL:-$(echo "$PROVIDER_INFO" | cut -d'|' -f2)}"
    AI_TOKEN="${AI_TOKEN:-$(echo "$PROVIDER_INFO" | cut -d'|' -f3)}"
  fi
fi
if [[ -z "$MODEL" || -z "$AI_BASE_URL" ]]; then
  echo "Error: could not determine AI provider. Configure a default AI provider in cronova, set CRONOVA_AI_BASE_URL and CRONOVA_AI_MODEL, or pass -r PROVIDER_ID and -m MODEL." >&2
  exit 1
fi

if [[ -z "$PROMPT_FILE" ]]; then
  echo "Error: -f PROMPT_FILE is required." >&2
  usage >&2
  exit 1
fi

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "Error: prompt file not found: $PROMPT_FILE" >&2
  exit 1
fi

if [[ -z "$WORKSPACE" ]]; then
  WORKSPACE="$REPO_ROOT/workspaces/maven-demo"
fi

PROJECT_DIR="$WORKSPACE/$PROJECT"
TMP_DIR="$REPO_ROOT/.tmp"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Error: project directory not found: $PROJECT_DIR" >&2
  exit 1
fi

mkdir -p "$TMP_DIR"

POM=$(cat "$PROJECT_DIR/pom.xml" 2>/dev/null || echo "")
APP=$(cat "$PROJECT_DIR/src/main/java/$(echo "$PACKAGE" | tr '.' '/')/App.java" 2>/dev/null || echo "")
TEST=$(cat "$PROJECT_DIR/src/test/java/$(echo "$PACKAGE" | tr '.' '/')/AppTest.java" 2>/dev/null || echo "")

USER_PROMPT=$(cat "$PROMPT_FILE")

FULL_PROMPT_FILE="$TMP_DIR/ai_feature_prompt.txt"
REQ_FILE="$TMP_DIR/ai_feature_request.json"
RESP_FILE="$TMP_DIR/ai_feature_response.json"

cat > "$FULL_PROMPT_FILE" <<PROMPT_EOF
You are a Java code generator.
$USER_PROMPT

Given the project below, return ONLY a JSON object where:
- key = relative file path (e.g. "src/main/java/com/example/luhn/Luhn.java" or "src/test/java/com/example/luhn/LuhnTest.java")
- value = full file content as a string
- optional key "pom_xml" = updated pom.xml if dependencies need changes

Do NOT add <version> tags to dependencies managed by the Maven parent or BOM.
Escape newlines in strings as \\n and quotes as \\".

pom.xml:
$POM

App.java:
$APP

AppTest.java:
$TEST
PROMPT_EOF

echo "Calling AI provider (model: $MODEL, url: $AI_BASE_URL)..."
"$PYTHON" "$REPO_ROOT/internal/scripts/ai_generate_feature.py" "$PROJECT_DIR" "$FULL_PROMPT_FILE" "$REQ_FILE" "$RESP_FILE" "$MODEL" "$AI_BASE_URL" "$AI_TOKEN"

echo "AI added feature to $PROJECT_DIR"
